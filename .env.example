# Copy to .env and fill in. NEVER commit real values.
POSTGRES_PASSWORD=change-me
MEDCART_ENV=production
MEDCART_JWT_SECRET=                 # python -c "import secrets;print(secrets.token_urlsafe(48))"
MEDCART_DATA_ENCRYPTION_KEYS=       # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  (newest first, comma-separated for rotation)
MEDCART_PAYMENT_MODE=live
MEDCART_PAYSTACK_SECRET_KEY=        # sk_live_... (sk_test_... while testing)
MEDCART_CORS_ORIGINS=["https://app.yourdomain.com"]
MEDCART_ANTHROPIC_API_KEY=          # AI assistant (without it, the assistant gives a safe "see a professional" reply)
MEDCART_LANGUAGE_PROVIDER=none      # none | google  (needs MEDCART_GOOGLE_API_KEY)
MEDCART_GOOGLE_API_KEY=
MEDCART_TURN_URLS=["turn:turn.yourdomain.com:3478"]   # required for reliable calls on mobile networks
MEDCART_TURN_SECRET=                # coturn static-auth-secret
